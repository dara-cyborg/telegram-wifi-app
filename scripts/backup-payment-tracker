#!/usr/bin/env bash
set -euo pipefail

backup_dir="/opt/backups/payment-tracker"
database="/opt/internet-payment-tracker/data/tracker.db"
timestamp="$(date +%Y%m%d-%H%M%S)"

mkdir -p "$backup_dir"
sqlite3 "$database" ".backup '$backup_dir/tracker-$timestamp.db'"
find "$backup_dir" -type f -name 'tracker-*.db' -mtime +14 -delete
