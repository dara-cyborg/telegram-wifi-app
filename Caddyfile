internet.daramongkol.tech {
    @probe path /wp-admin* /wp-login.php /xmlrpc.php /.env /.git/* /phpmyadmin* /server-status
    respond @probe 404

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.tailwindcss.com https://telegram.org; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }

    reverse_proxy 127.0.0.1:8001
}
